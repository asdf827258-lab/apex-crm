# ════════════════════════════════════════════════════════════════════════
# 이 파일을 복사해 .env 로 만들고 값을 채우세요:  cp .env.example .env
#
# ⚠️ .env 는 .gitignore 에 들어 있어 깃에 올라가지 않습니다. 절대 공유 금지.
# ⚠️ 여기에는 예시값만 있습니다. 진짜 키를 이 파일에 적지 마세요.
# ════════════════════════════════════════════════════════════════════════

# ── 모의계좌(Paper) 키 ──────────────────────────────────────────────────
# https://app.alpaca.markets → 우측 상단을 'Paper' 로 전환한 뒤 발급
# Secret 은 발급 순간 한 번만 보입니다. 그때 복사하세요.
ALPACA_API_KEY=여기에_모의계좌_키
ALPACA_SECRET_KEY=여기에_모의계좌_시크릿

# ── 모의/실계좌 스위치 ──────────────────────────────────────────────────
# true  = 모의투자 (기본값. 이 줄이 없어도 모의로 붙습니다)
# false = 실계좌  ← 아래 ALPACA_LIVE_CONFIRM 과 --live 플래그가 모두 있어야 열립니다
ALPACA_PAPER=true

# ── 실계좌 3중 잠금 중 두 번째 열쇠 ─────────────────────────────────────
# 실계좌로 갈 때만 아래 줄의 주석을 풀고 정확히 이 문구를 넣습니다.
# 오타가 있으면 열리지 않습니다(일부러 그렇게 만들었습니다).
# ALPACA_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY

# ── 리포트 전송 (선택) ──────────────────────────────────────────────────
# 슬랙·디스코드 등의 Incoming Webhook 주소. 비워 두면 파일로만 남깁니다.
# 미리 보려면:  python main.py report --evening --dry-run   (전송하지 않습니다)
# 이 주소 자체가 비밀입니다 — 아는 사람은 누구나 그 채널에 글을 쓸 수 있습니다.
REPORT_WEBHOOK_URL=

# ════════════════════════════════════════════════════════════════════════
# 국내 주식 (한국투자증권) — 여기부터는 국내 주문용입니다
#
# apiportal.koreainvestment.com 에서 발급합니다. 호출 IP 등록이 없습니다.
# 모의투자 계좌를 따로 만들 수 있어서, 실계좌 없이도 끝까지 연습됩니다.
# ════════════════════════════════════════════════════════════════════════
KIS_APP_KEY=여기에_앱키
KIS_APP_SECRET=여기에_앱시크릿

# 종합계좌번호 8자리 + 상품코드 2자리
KIS_ACCOUNT=12345678-01

# ── 모의/실계좌 스위치 ──────────────────────────────────────────────────
# true  = 모의투자 (기본값. 이 줄이 없어도 모의로 붙습니다)
# false = 실계좌  ← KIS_LIVE_CONFIRM 과 --live 와 --send 가 모두 있어야 나갑니다
KIS_PAPER=true

# ── 실계좌 3중 잠금 중 두 번째 열쇠 ─────────────────────────────────────
# 실계좌로 갈 때만 아래 줄의 주석을 풀고 정확히 이 문구를 넣습니다.
# KIS_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY
